# Copy to .env and fill in values. Do not commit secrets.

# DATABASE_URL=sqlite:///./fitclash.db

# Neon S3-compatible object storage for profile photos
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=fitclash-avatars

# Web Push (generate with: python -m py_vapid --gen)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Render cron jobs POST /internal/cron/* with this header
# CRON_SECRET=
